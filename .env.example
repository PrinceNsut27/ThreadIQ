# ThreadIQ Environment Configuration Template
# Copy this file to .env and populate with your local values if needed.

# Application Environment
ENV=development
RANDOM_SEED=42

# Optional Kaggle API Credentials for automated download
# Found at https://www.kaggle.com/settings -> "Create New Token"
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Database Path (defaults to local data/threadiq.db)
DATABASE_URL=sqlite:///data/threadiq.db

# Optional LLM API Key (for qualitative review summaries)
OPENAI_API_KEY=
